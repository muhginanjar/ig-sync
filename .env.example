# Instagram API (Instagram Login)
IG_APP_ID=
IG_APP_SECRET=
IG_ACCESS_TOKEN=

# Wasabi (S3-compatible)
WASABI_REGION=ap-southeast-1
WASABI_ENDPOINT=https://s3.ap-southeast-1.wasabisys.com
WASABI_BUCKET=
WASABI_ACCESS_KEY_ID=
WASABI_SECRET_ACCESS_KEY=

# SQLite
DATABASE_PATH=./data/app.db

# URL publik aplikasi, lengkap dengan https:// (untuk preview link, pengingat, CORS)
SITE_URL=http://localhost:3000

# Port aplikasi web (dipakai PM2)
PORT=3000

# Password halaman /admin (minimal 8 karakter)
ADMIN_PASSWORD=

# Nama aplikasi di header & judul tab (opsional, default: @username akun IG)
SITE_NAME=
